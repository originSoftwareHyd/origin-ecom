# Apache/LiteSpeed config for the static export (npm run build:static). Upload with the rest of dist/ to public_html.

Options -Indexes -MultiViews
DirectorySlash Off
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical origin: https://www.originecommerce.com
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301,NE]

  # Contact form: the site posts to /api/contact, handled by the PHP mailer (deploy/contact.php).
  RewriteRule ^api/contact$ api/contact.php [L]
  # Holds the dashboard token: never served directly.
  RewriteRule ^api/contact-config\.php$ - [F,L]

  # Drop trailing slashes (canonical URLs have none): /contact/ -> /contact
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [L,R=301]

  # /index.html and /contact.html -> clean URLs
  RewriteCond %{THE_REQUEST} \s/+(.*?)(?:index)?\.html[\s?] [NC]
  RewriteRule ^ /%1 [L,R=301,NE]

  # Clean URLs: /contact -> contact.html, /ar -> ar.html
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]

  # Directories without a same-named .html file: serve their index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ $1/index.html [L]
</IfModule>

ErrorDocument 404 /404.html

# Social preview images are exported without an extension (/opengraph-image, /services/<slug>/opengraph-image).
<Files "opengraph-image">
  ForceType image/png
</Files>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/plain .txt
  AddCharset utf-8 .html .txt .xml .css .js .json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  # Hashed build assets never change; HTML must always revalidate so deploys show up immediately.
  <FilesMatch "\.(html|txt|xml|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>
