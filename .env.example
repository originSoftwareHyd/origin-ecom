# ── Business identity (NAP). Must match Google Business Profile and directory listings exactly. ──
NEXT_PUBLIC_SITE_URL=https://www.originecommerce.com
NEXT_PUBLIC_CONTACT_EMAIL=info@originsoftwares.com
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_ARABIC_NAME=
NEXT_PUBLIC_CR_NUMBER=
NEXT_PUBLIC_VAT_NUMBER=
NEXT_PUBLIC_ADDRESS_STREET=
NEXT_PUBLIC_ADDRESS_CITY=
NEXT_PUBLIC_ADDRESS_REGION=
NEXT_PUBLIC_ADDRESS_POSTAL_CODE=
# Comma-separated profile URLs (LinkedIn, X, Instagram, Snapchat, Google Business Profile)
NEXT_PUBLIC_SOCIAL_PROFILES=

# ── Search engine verification ──
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Contact form. Without these, the form opens a pre-filled email draft instead. ──
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_ENABLE_CONTACT_FORM=false
CONTACT_WEBHOOK_URL=

# ── Analytics. GA4 measurement ID (G-XXXXXXX). Leave empty to load no analytics. Mark generate_lead,
# whatsapp_click and phone_click as key events in GA4. ──
NEXT_PUBLIC_GA_ID=
